---
// On-screen buttons for phones, shown only while playing full screen. Each one acts like the
// keyboard key the game already listens to, so holding a button = holding the key.
import Icona from '../Icona.astro';

interface Tasto { tasto: string; etichetta: string; icona: 'sinistra' | 'destra' | 'su' | 'giu' }
interface Props { sinistra: Tasto; destra: Tasto }
const { sinistra, destra } = Astro.props;
---

<div class="comandi" data-comandi>
  <button type="button" class="tasto" data-tasto={sinistra.tasto} aria-label={sinistra.etichetta}>
    <Icona nome={sinistra.icona} /><span>{sinistra.etichetta}</span>
  </button>
  <button type="button" class="esci" data-esci aria-label="Esci dal gioco"><Icona nome="chiudi" /></button>
  <button type="button" class="tasto" data-tasto={destra.tasto} aria-label={destra.etichetta}>
    <Icona nome={destra.icona} /><span>{destra.etichetta}</span>
  </button>
</div>

<script>
  import { abbandona } from '../../lib/giochi/schermo-intero';

  const LATERALI = ['ArrowLeft', 'ArrowRight'];
  const premuti = new Set<string>();
  const invia = (tipo: 'keydown' | 'keyup', key: string) => window.dispatchEvent(new KeyboardEvent(tipo, { key }));

  document.querySelectorAll<HTMLButtonElement>('[data-tasto]').forEach((b) => {
    const key = b.dataset.tasto!;
    const giu = (e: PointerEvent) => {
      e.preventDefault();
      try { b.setPointerCapture(e.pointerId); } catch { /* synthetic or already released */ }
      premuti.add(key);
      b.classList.add('premuto');
      invia('keydown', key);
    };
    const su = () => {
      if (!premuti.delete(key)) return;
      b.classList.remove('premuto');
      invia('keyup', key);
      // Left released while right is still held: keep going right.
      premuti.forEach((k) => LATERALI.includes(k) && invia('keydown', k));
    };
    b.addEventListener('pointerdown', giu);
    b.addEventListener('pointerup', su);
    b.addEventListener('pointercancel', su);
    b.addEventListener('lostpointercapture', su);
    b.addEventListener('contextmenu', (e) => e.preventDefault());
  });
  document.querySelectorAll('[data-esci]').forEach((b) => b.addEventListener('click', abbandona));
</script>

<style>
  .comandi { display: none; }
  :global(.a-tutto-schermo) .comandi {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--s-2);
    min-height: 104px;
    max-height: 42dvh;
    margin-top: auto; /* buttons sit at the bottom, under the thumbs */
    padding: var(--s-2) var(--s-3) calc(var(--s-3) + env(safe-area-inset-bottom));
  }
  .tasto, .esci {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--s-1);
    border: 2px solid var(--carta);
    border-radius: 0;
    background: var(--ink-3);
    color: var(--carta);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .tasto { font-family: var(--f-display); font-weight: 900; font-size: var(--t-m); text-transform: uppercase; }
  .tasto :global(.icona) { width: 36px; height: 36px; }
  .tasto.premuto { background: var(--rosso); border-color: var(--rosso); }
  .esci { width: 48px; align-self: start; height: 48px; border-color: var(--carta-tenue); color: var(--carta-tenue); background: transparent; }
  .esci :global(.icona) { width: 20px; height: 20px; }
</style>

<style is:global>
  html.gioco-aperto, html.gioco-aperto body { overflow: hidden; }
  html .palco.a-tutto-schermo {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    border: 0;
    padding-top: env(safe-area-inset-top);
    background: var(--ink);
  }
  html .palco.a-tutto-schermo > .tela {
    flex: none;
    width: min(100%, calc((100dvh - 120px - env(safe-area-inset-top) - env(safe-area-inset-bottom)) * var(--rapporto)));
    max-height: none;
    margin-inline: auto;
  }
  html .palco.a-tutto-schermo > .hud { top: env(safe-area-inset-top); }
</style>
