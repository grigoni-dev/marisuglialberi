---
// Leaderboard with "this week" / "all time" tabs. Filled in the browser (see client.ts).
interface Props { gioco: 'tequila' | 'ritardo'; unita: string }
const { gioco, unita } = Astro.props;
---
<section class="classifica" aria-labelledby={`cl-${gioco}`} data-classifica={gioco} data-unita={unita}>
  <div class="cl-testa">
    <h2 id={`cl-${gioco}`}>Classifica</h2>
    <div class="cl-schede" role="group" aria-label="Periodo">
      <button type="button" aria-pressed="true" data-periodo="gara">Gara in corso</button>
      <button type="button" aria-pressed="false" data-periodo="sempre">Di sempre</button>
    </div>
  </div>
  <ol class="cl-lista" data-cl-lista><li class="vuota">Carico…</li></ol>
  <p class="cl-gara" data-cl-gara></p>
  <p class="cl-premio">Chi è primo quando si chiude la gara vince un gadget del merch e lo ritira a quel live. Poi si riparte da zero.</p>
  <p class="cl-vinta" data-cl-vinta hidden></p>
</section>

<script>
  import { classifica, disegnaClassifica, gare, nomeSalvato, testoChiusura, type Gioco, type Periodo } from '../../lib/giochi/client';
  const giro = gare();
  for (const box of document.querySelectorAll<HTMLElement>('[data-classifica]')) {
    const gioco = box.dataset.classifica as Gioco;
    const lista = box.querySelector<HTMLElement>('[data-cl-lista]')!;
    let periodo: Periodo = 'gara';
    const carica = async () => disegnaClassifica(lista, await classifica(gioco, periodo), box.dataset.unita!, nomeSalvato());
    // When the round closes, and who won the last one.
    giro.then(async ({ corrente, precedente }) => {
      box.querySelector('[data-cl-gara]')!.textContent = testoChiusura(corrente);
      if (precedente) {
        const [primo] = await classifica(gioco, 'precedente', 1);
        if (primo) {
          const v = box.querySelector<HTMLElement>('[data-cl-vinta]')!;
          v.textContent = `L'ultima gara l'ha vinta ${primo.nome} con ${primo.punti.toLocaleString('it-IT')} ${box.dataset.unita}.`;
          v.hidden = false;
        }
      }
    });
    for (const b of box.querySelectorAll<HTMLButtonElement>('[data-periodo]')) {
      b.addEventListener('click', () => {
        periodo = b.dataset.periodo as Periodo;
        box.querySelectorAll('[data-periodo]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        carica();
      });
    }
    box.addEventListener('aggiorna', carica);
    carica();
  }
</script>

<style>
  .classifica { display: grid; gap: var(--s-3); }
  .cl-testa { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--s-3); }
  .cl-testa h2 { font-size: var(--t-xl); }
  .cl-schede { display: flex; gap: var(--s-1); }
  .cl-schede button {
    min-height: 40px;
    padding: 0 var(--s-3);
    border: var(--filetto);
    background: var(--carta);
    font-weight: 700;
    font-size: var(--t-s);
  }
  .cl-schede button[aria-pressed='true'] { background: var(--ink); color: var(--carta); }
  .cl-lista { list-style: none; padding: 0; border-top: var(--filetto); counter-reset: none; }
  .cl-lista :global(li) {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-2);
    border-bottom: 1px solid var(--ink);
  }
  .cl-lista :global(.pos) { font-family: var(--f-display); font-weight: 900; font-variant-numeric: tabular-nums; }
  .cl-lista :global(li:first-child .pos) { color: var(--rosso); }
  .cl-lista :global(.chi) { font-weight: 700; overflow-wrap: anywhere; }
  .cl-lista :global(.quanti) { font-variant-numeric: tabular-nums; color: var(--ink-2); }
  .cl-lista :global(.tu) { background: var(--teal-chiaro); }
  .cl-lista :global(.vuota) { display: block; color: var(--ink-2); }
  .cl-gara { font-weight: 700; }
  .cl-premio { font-size: var(--t-s); color: var(--ink-2); }
  .cl-vinta { font-size: var(--t-s); font-weight: 700; color: var(--teal); }
</style>
