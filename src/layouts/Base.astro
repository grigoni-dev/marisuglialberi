---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  themeColor?: string;
}

const { title, description, image = '/condivisione.jpg', noindex = false, themeColor = '#f3eee4' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const immagine = new URL(image, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Mari sugli alberi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={immagine} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <slot />
  </body>
</html>
