  .adm-logo { width: 56px; color: var(--ink); }
  .adm-titolo { font-family: var(--f-display); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; }
  .adm-esci, .secondario {
    min-height: 44px;
    padding: 0 var(--s-4);
    border: var(--filetto);
    background: var(--carta);
    font-weight: 700;
  }
  .adm-esci { margin-left: auto; }
  .adm-esci:hover, .secondario:hover { background: var(--ink); color: var(--carta); }
  .pericolo { color: var(--rosso-scuro); border-color: var(--rosso-scuro); }
  .pericolo:hover { background: var(--rosso-scuro); color: var(--carta); }

  .adm { padding-block: var(--s-5) var(--s-8); }
  .adm h1 { font-size: var(--t-xl); margin-bottom: var(--s-4); }
  .adm h2 { font-size: var(--t-l); margin-bottom: var(--s-3); }
