    // ---------- Photos ----------
    type FotoRiga = { id: string; path: string; thumb_path: string; alt: string | null; pubblicata: boolean };
    const urlFoto = (p: string) => `${PUBLIC_SUPABASE_URL}/storage/v1/object/public/foto/${p}`;
    let foto: FotoRiga[] = [];

    async function ridimensiona(img: ImageBitmap, lato: number, qualita: number) {
      const k = Math.min(1, lato / Math.max(img.width, img.height));
      const w = Math.round(img.width * k), h = Math.round(img.height * k);
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const ctx = c.getContext('2d')!;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, 0, 0, w, h);
      let blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/webp', qualita));
      if (!blob || blob.type !== 'image/webp') blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', qualita + 0.05));
      if (!blob) throw new Error('conversione non riuscita');
      return { blob, w, h, ext: blob.type === 'image/webp' ? 'webp' : 'jpg' };
    }

    async function caricaFoto() {
      const { data, error } = await sb.from('foto').select('id,path,thumb_path,alt,pubblicata').order('created_at', { ascending: false });
      if (error) return msg(`Non riesco a leggere le foto: ${error.message}`, true);
      foto = data as FotoRiga[];
      $('[data-conta-foto]').textContent = `(${foto.filter((f) => f.pubblicata).length} visibili su ${foto.length})`;
      $('[data-lista-foto]').innerHTML = foto.map((f) => `
        <li class="${f.pubblicata ? '' : 'nascosta'}">
          <img src="${esc(urlFoto(f.thumb_path))}" alt="${esc(f.alt ?? '')}" loading="lazy" />
          <div class="foto-azioni">
            <button type="button" class="secondario" data-foto-mostra="${f.id}">${f.pubblicata ? 'Nascondi' : 'Mostra'}</button>
            <button type="button" class="secondario pericolo" data-foto-elimina="${f.id}">Elimina</button>
          </div>
        </li>`).join('') || '<li class="vuota">Ancora nessuna foto.</li>';
    }

    $('[data-carica]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formFoto = e.target as HTMLFormElement;
      const files = [...(formFoto.elements.namedItem('file') as HTMLInputElement).files ?? []];
      const alt = (formFoto.elements.namedItem('alt') as HTMLInputElement).value.trim() || null;
      if (!files.length) return msg('Scegli almeno una foto.', true);
      const bottone = $<HTMLButtonElement>('[data-carica-invia]');
      const progresso = $('[data-progresso]');
      bottone.disabled = true;
      let fatte = 0, fallite = 0;
      for (const file of files) {
        progresso.textContent = `Carico ${fatte + fallite + 1} di ${files.length}…`;
        try {
          const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
          const [g, t] = [await ridimensiona(bmp, 2048, 0.82), await ridimensiona(bmp, 640, 0.72)];
          bmp.close();
          const base = `${new Date().getFullYear()}/${crypto.randomUUID()}`;
          const path = `${base}.${g.ext}`, thumb = `${base}-mini.${t.ext}`;
          const opt = { cacheControl: '31536000', upsert: false };
          const [a, b] = await Promise.all([
            sb.storage.from('foto').upload(path, g.blob, { ...opt, contentType: g.blob.type }),
            sb.storage.from('foto').upload(thumb, t.blob, { ...opt, contentType: t.blob.type }),
          ]);
          if (a.error || b.error) throw a.error ?? b.error;
          const { error } = await sb.from('foto').insert({ path, thumb_path: thumb, width: g.w, height: g.h, thumb_width: t.w, thumb_height: t.h, alt });
          if (error) {
            await sb.storage.from('foto').remove([path, thumb]);
            throw error;
          }
          fatte++;
        } catch (err) {
          console.error('caricamento foto', err);
          fallite++;
        }
      }
      bottone.disabled = false;
      progresso.textContent = '';
      formFoto.reset();
      msg(fallite ? `Caricate ${fatte}, non riuscite ${fallite}.` : `Caricate ${fatte} foto. Sul sito compaiono entro un minuto.`, fallite > 0);
      caricaFoto();
    });

    document.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-foto-mostra],[data-foto-elimina]');
      if (!b) return;
      const f = foto.find((x) => x.id === (b.dataset.fotoMostra ?? b.dataset.fotoElimina));
      if (!f) return;
      if (b.dataset.fotoMostra) {
        const { error } = await sb.from('foto').update({ pubblicata: !f.pubblicata }).eq('id', f.id);
        if (error) return msg(`Non riesco a cambiarla: ${error.message}`, true);
        msg(f.pubblicata ? 'Foto nascosta dal sito.' : 'Foto di nuovo visibile.');
      } else {
        if (!confirm('Eliminare questa foto? Non si può annullare.')) return;
