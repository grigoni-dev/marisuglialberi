      };
      const id = t('id');
      // Place the city on the map when it's new or has changed.
      const prima = concerti.find((c) => c.id === id);
      if (!prima || prima.lat == null || prima.citta.trim().toLowerCase() !== riga.citta.toLowerCase()) {
        const pos = await trovaCitta(riga.citta);
        Object.assign(riga, pos ? { lat: pos.lat, lng: pos.lng } : { lat: null, lng: null });
        if (!pos) msg(`Non trovo "${riga.citta}" sulla mappa: la data si salva lo stesso.`, true);
