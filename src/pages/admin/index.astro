    $('[data-posizioni-trova]').addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true;
      const mancanti = concerti.filter((c) => c.lat == null);
      const cache = new Map<string, { lat: number; lng: number } | null>();
      let trovate = 0;
      for (const c of mancanti) {
        const k = c.citta.trim().toLowerCase();
        if (!cache.has(k)) {
          cache.set(k, await trovaCitta(c.citta));
          await new Promise((r) => setTimeout(r, 1100)); // OpenStreetMap asks for at most one request per second
        }
        const pos = cache.get(k);
        if (pos && !(await sb.from('concerti').update({ lat: pos.lat, lng: pos.lng }).eq('id', c.id)).error) trovate++;
      }
      b.disabled = false;
      msg(`Posizioni trovate: ${trovate} su ${mancanti.length}.`, trovate < mancanti.length);
      caricaDate();
    });

