    // ---------- Famous lines and testimonials: the same small editor for both ----------
    type Voce = { id: string; testo: string; chi: string | null; occasione?: string | null; pubblicata: boolean };
    function editor(cfg: {
      tabella: 'frasi' | 'testimonianze';
      form: string; lista: string; titolo: string; salva: string; annulla: string;
      nuovo: string; modifica: string; campi: string[]; vuoto: string;
      riassunto: (v: Voce) => string;
    }) {
      const f = $<HTMLFormElement>(cfg.form);
      let voci: Voce[] = [];
      const el = (n: string) => f.elements.namedItem(n) as HTMLInputElement;
      const reset = () => {
        f.reset();
        el('id').value = '';
        $(cfg.titolo).textContent = cfg.nuovo;
        $(cfg.annulla).hidden = true;
      };
      $(cfg.annulla).addEventListener('click', reset);
      const carica = async () => {
        const { data, error } = await sb.from(cfg.tabella).select('*').order('created_at', { ascending: false });
        if (error) return msg(`Non riesco a leggere: ${error.message}`, true);
        voci = data as Voce[];
        $(cfg.lista).innerHTML = voci.map((v) => `
          <li class="voce${v.pubblicata ? '' : ' nascosta'}">
            <div>${cfg.riassunto(v)}<span class="etichette">${v.pubblicata ? '' : '<em>Non sul sito</em>'}</span></div>
            <div class="voce-azioni">
              <button type="button" class="secondario" data-ed-modifica="${cfg.tabella}:${v.id}">Modifica</button>
              <button type="button" class="secondario pericolo" data-ed-elimina="${cfg.tabella}:${v.id}">Elimina</button>
            </div>
          </li>`).join('') || `<li class="vuota">${cfg.vuoto}</li>`;
      };
      document.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-ed-modifica],[data-ed-elimina]');
        if (!b) return;
        const [tab, id] = (b.dataset.edModifica ?? b.dataset.edElimina)!.split(':');
        if (tab !== cfg.tabella) return;
        const v = voci.find((x) => x.id === id);
        if (!v) return;
        if (b.dataset.edModifica) {
          el('id').value = v.id;
          for (const c of cfg.campi) (f.elements.namedItem(c) as HTMLInputElement).value = (v as any)[c] ?? '';
          el('pubblicata').checked = v.pubblicata;
          $(cfg.titolo).textContent = cfg.modifica;
          $(cfg.annulla).hidden = false;
          f.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          if (!confirm('Eliminarla? Non si può annullare.')) return;
          const { error } = await sb.from(cfg.tabella).delete().eq('id', v.id);
          if (error) return msg(`Non riesco a eliminarla: ${error.message}`, true);
          msg('Eliminata.');
          carica();
        }
      });
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const d = new FormData(f);
        const riga: Record<string, unknown> = { pubblicata: d.get('pubblicata') === 'on' };
        for (const c of cfg.campi) riga[c] = String(d.get(c) ?? '').trim() || null;
        if (!riga.testo) return msg('Manca il testo.', true);
        if (cfg.tabella === 'testimonianze' && !riga.chi) return msg('Manca chi l\'ha detto.', true);
        const id = el('id').value;
        const { error } = id ? await sb.from(cfg.tabella).update(riga).eq('id', id) : await sb.from(cfg.tabella).insert(riga);
        if (error) return msg(`Non riesco a salvare: ${error.message}`, true);
        msg('Salvato. Sul sito si vede alla prossima apertura della pagina.');
        reset();
        carica();
      });
      return carica;
    }

    const caricaFrasi = editor({
      tabella: 'frasi', form: '[data-form-frase]', lista: '[data-lista-frasi]', titolo: '[data-frase-titolo]',
      salva: '[data-frase-salva]', annulla: '[data-frase-annulla]', nuovo: 'Nuova frase', modifica: 'Modifica la frase',
