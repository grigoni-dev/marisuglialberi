  .posizioni { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin-top: var(--s-3); color: var(--ink-2); }
  .adm-msg { min-height: 1.5em; margin-bottom: var(--s-3); font-weight: 700; color: var(--teal); }
  .adm-msg.errore { color: var(--rosso-scuro); }

  .schede { display: flex; gap: var(--s-2); border-bottom: var(--filetto); margin-bottom: var(--s-5); overflow-x: auto; }
  .schede button { flex: none; }
  .schede button {
    min-height: 48px;
    padding: 0 var(--s-4);
    border: 0;
    background: transparent;
    font-family: var(--f-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: var(--t-m);
  }
  .schede button[aria-selected='true'] { background: var(--ink); color: var(--carta); }
  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 1.5em;
    height: 1.5em;
    margin-left: var(--s-1);
    padding: 0 0.3em;
    background: var(--rosso);
    color: var(--carta);
    font-family: var(--f-text);
    font-size: var(--t-xs);
  }

  .adm-griglia { display: grid; gap: var(--s-7); }
  @media (min-width: 960px) { .adm-griglia { grid-template-columns: minmax(0, 420px) 1fr; align-items: start; } }

  .adm-form { display: grid; gap: var(--s-4); }
  .adm-login { max-width: 420px; }
  .due { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
  .campo { display: grid; gap: var(--s-1); }
  .campo label { font-weight: 700; }
  .facoltativo { font-weight: 400; color: var(--ink-2); }
  .adm-form input:not([type='checkbox']), .adm-form textarea, select {
    width: 100%;
    min-height: 48px;
    padding: var(--s-2) var(--s-3);
    border: 0;
    border-bottom: var(--filetto);
    border-radius: 0;
    background: var(--carta-2);
    font-size: var(--t-m);
  }
  select { width: auto; min-height: 40px; }
  .spunta { display: flex; align-items: center; gap: var(--s-3); min-height: 44px; font-weight: 700; }
  .spunta input { width: 22px; height: 22px; accent-color: var(--ink); flex: none; }
  .azioni { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; }

  .lista, .richieste { list-style: none; padding: 0; border-bottom: var(--filetto); }
  .lista :global(.voce) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) 0;
    border-top: var(--filetto);
  }
  .lista :global(.voce > div:first-child) { display: grid; gap: 2px; }
  .lista :global(.nascosta) { opacity: 0.6; }
  .lista :global(.etichette em), .richieste :global(.etichette em) {
    display: inline-block;
    margin-right: var(--s-2);
    padding: 0 var(--s-2);
    font-style: normal;
    font-size: var(--t-xs);
    font-weight: 700;
    background: var(--teal-chiaro);
    color: var(--teal-scuro);
  }
  .lista :global(.voce-azioni) { display: flex; gap: var(--s-2); }
  .lista :global(.vuota), .richieste :global(.vuota) { padding: var(--s-3) 0; border-top: var(--filetto); color: var(--ink-2); }

  .richieste :global(.richiesta) { padding: var(--s-4) 0; border-top: var(--filetto); display: grid; gap: var(--s-3); }
  .richieste :global(.nuova-tag) { display: inline-block; margin-right: var(--s-2); padding: 0 var(--s-2); background: var(--rosso); color: var(--carta); font-family: var(--f-text); font-size: var(--t-xs); font-weight: 700; text-transform: none; letter-spacing: 0; vertical-align: middle; }
  .richieste :global(.richiesta-testa) { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3); }
  .richieste :global(.richiesta-testa strong) { font-family: var(--f-display); font-weight: 900; text-transform: uppercase; font-size: var(--t-l); letter-spacing: -0.02em; }
  .richieste :global(.richiesta-testa label) { display: flex; align-items: center; gap: var(--s-2); font-weight: 700; }
  .richieste :global(dl) { display: grid; gap: var(--s-1); }
  .richieste :global(dl div) { display: grid; grid-template-columns: 6rem 1fr; gap: var(--s-3); }
  .richieste :global(dt) { font-weight: 700; }
  .carica { max-width: 560px; }
  .merch-foto { display: grid; gap: var(--s-3); margin-top: var(--s-4); padding-top: var(--s-4); border-top: var(--filetto); }
  .merch-foto h3 { font-size: var(--t-m); }
  .carica input[type='file'] { padding: var(--s-3); }
  .progresso { font-weight: 700; color: var(--teal); }
  .griglia-foto { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--s-3); }
  .griglia-foto :global(li) { display: grid; gap: var(--s-2); }
  .griglia-foto :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--carta-2); }
  .griglia-foto :global(.nascosta img) { opacity: 0.4; }
  .griglia-foto :global(.foto-azioni) { display: flex; gap: var(--s-2); }
  .griglia-foto :global(.foto-azioni button) { flex: 1; min-height: 40px; padding: 0 var(--s-2); font-size: var(--t-s); }
  .griglia-foto :global(.vuota) { grid-column: 1 / -1; color: var(--ink-2); }
  .richieste :global(.richiesta-msg) { padding: var(--s-3); background: var(--carta-2); white-space: pre-line; }
</style>
