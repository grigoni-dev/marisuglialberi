---
// Band panel: sign in, manage gig dates, read and triage booking requests.
// Everything runs in the browser with the user's Supabase session, protected by RLS.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
---

<Base title="Pannello · Mari sugli alberi" description="Pannello della band." noindex>
  <header class="adm-barra">
    <div class="wrap adm-barra-dentro">
      <a class="adm-logo" href="/" aria-label="Vai al sito"><Logo /></a>
      <span class="adm-titolo">Pannello</span>
      <button type="button" class="adm-esci" data-esci hidden>Esci</button>
    </div>
  </header>

  <main id="contenuto" class="wrap adm">
    <p class="adm-msg" role="status" aria-live="polite"></p>

    <section data-vista="non-configurato" hidden>
      <h1>Pannello non ancora attivo</h1>
      <p>Supabase non è collegato: mancano le variabili <code>PUBLIC_SUPABASE_URL</code> e <code>PUBLIC_SUPABASE_ANON_KEY</code>. Vedi <code>SETUP.md</code>.</p>
    </section>

    <section data-vista="login" hidden>
      <h1>Entra</h1>
      <form class="adm-form adm-login" data-login>
        <div class="campo">
          <label for="l-email">Email</label>
          <input id="l-email" name="email" type="email" autocomplete="username" required />
        </div>
        <div class="campo">
          <label for="l-password">Password</label>
          <input id="l-password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <button class="bottone" type="submit">Entra</button>
      </form>
    </section>

    <section data-vista="pannello" hidden>
      <div class="schede" role="tablist" aria-label="Sezioni del pannello">
        <button type="button" role="tab" id="t-date" aria-controls="p-date" aria-selected="true" data-scheda="date">Date</button>
        <button type="button" role="tab" id="t-richieste" aria-controls="p-richieste" aria-selected="false" data-scheda="richieste">
          Richieste <span class="badge" data-badge hidden></span>
        </button>
        <button type="button" role="tab" id="t-foto" aria-controls="p-foto" aria-selected="false" data-scheda="foto">Foto</button>
        <button type="button" role="tab" id="t-frasi" aria-controls="p-frasi" aria-selected="false" data-scheda="frasi">Frasi</button>
        <button type="button" role="tab" id="t-testimonianze" aria-controls="p-testimonianze" aria-selected="false" data-scheda="testimonianze">Testimonianze</button>
        <button type="button" role="tab" id="t-ospiti" aria-controls="p-ospiti" aria-selected="false" data-scheda="ospiti">Ospiti</button>
        <button type="button" role="tab" id="t-collab" aria-controls="p-collab" aria-selected="false" data-scheda="collab">Collab</button>
        <button type="button" role="tab" id="t-merch" aria-controls="p-merch" aria-selected="false" data-scheda="merch">Merch</button>
      </div>

      <!-- Dates -->
      <div role="tabpanel" id="p-date" aria-labelledby="t-date" data-pannello="date">
        <div class="adm-griglia">
          <form class="adm-form" data-form-data novalidate>
            <h2 data-form-titolo>Nuova data</h2>
            <input type="hidden" name="id" />
            <div class="due">
              <div class="campo">
                <label for="d-data">Giorno</label>
                <input id="d-data" name="data" type="date" required />
              </div>
              <div class="campo">
                <label for="d-ora">Ora <span class="facoltativo">(facoltativa)</span></label>
                <input id="d-ora" name="ora" type="time" />
              </div>
            </div>
            <div class="campo">
              <label for="d-citta">Città</label>
              <input id="d-citta" name="citta" type="text" required maxlength="80" />
            </div>
            <div class="campo">
              <label for="d-locale">Locale <span class="facoltativo">(non si vede se è una festa privata)</span></label>
              <input id="d-locale" name="locale" type="text" maxlength="120" />
            </div>
            <div class="campo">
              <label for="d-link">Link all'evento <span class="facoltativo">(facoltativo, inizia con https://)</span></label>
              <input id="d-link" name="link" type="url" placeholder="https://www.instagram.com/p/…" />
            </div>
            <label class="spunta"><input type="checkbox" name="privato" /> <span>Festa privata (sul sito: solo città e "Festa privata")</span></label>
            <label class="spunta"><input type="checkbox" name="pubblicato" checked /> <span>Mostra sul sito</span></label>
            <div class="campo">
              <label for="d-note">Note interne <span class="facoltativo">(non si vedono mai sul sito)</span></label>
              <textarea id="d-note" name="note" rows="3" maxlength="2000"></textarea>
            </div>
            <div class="azioni">
              <button class="bottone" type="submit" data-salva>Salva la data</button>
              <button class="secondario" type="button" data-annulla hidden>Annulla</button>
            </div>
          </form>

          <div>
            <h2>Prossime</h2>
            <ol class="lista" data-lista-prossime></ol>
            <h2 class="spazio">Passate</h2>
            <p class="posizioni" data-posizioni hidden>
              <span data-posizioni-testo></span>
              <button type="button" class="secondario" data-posizioni-trova>Trova le posizioni</button>
            </p>
            <ol class="lista" data-lista-passate></ol>
          </div>
        </div>
      </div>

      <!-- Photos -->
      <div role="tabpanel" id="p-foto" aria-labelledby="t-foto" data-pannello="foto" hidden>
        <form class="adm-form carica" data-carica>
          <h2>Carica foto</h2>
          <div class="campo">
            <label for="f-file">Scegli una o più foto</label>
            <input id="f-file" name="file" type="file" accept="image/*" multiple required />
            <p class="facoltativo">Vengono ridimensionate sul tuo dispositivo prima di caricarle (circa 300 KB l'una), quindi vanno bene anche quelle grandi del telefono.</p>
          </div>
          <div class="campo">
            <label for="f-alt">Descrizione per chi non vede <span class="facoltativo">(facoltativa, vale per tutte le foto di questo caricamento)</span></label>
            <input id="f-alt" name="alt" type="text" maxlength="300" placeholder="Foto dal vivo di Mari sugli alberi" />
          </div>
          <div class="azioni">
            <button class="bottone" type="submit" data-carica-invia>Carica</button>
            <p class="progresso" aria-live="polite" data-progresso></p>
          </div>
        </form>
        <h2 class="spazio">Nella galleria <span class="facoltativo" data-conta-foto></span></h2>
        <ol class="griglia-foto" data-lista-foto></ol>
      </div>

      <!-- Famous lines -->
      <div role="tabpanel" id="p-frasi" aria-labelledby="t-frasi" data-pannello="frasi" hidden>
        <div class="adm-griglia">
          <form class="adm-form" data-form-frase novalidate>
            <h2 data-frase-titolo>Nuova frase</h2>
            <input type="hidden" name="id" />
            <div class="campo">
              <label for="fr-testo">La frase</label>
              <textarea id="fr-testo" name="testo" rows="3" maxlength="280" required></textarea>
            </div>
            <div class="campo">
              <label for="fr-chi">Chi l'ha detta <span class="facoltativo">(vuoto = la band; i fan solo con il loro permesso)</span></label>
              <input id="fr-chi" name="chi" type="text" maxlength="80" />
            </div>
            <label class="spunta"><input type="checkbox" name="pubblicata" checked /> <span>Mostra sul sito</span></label>
            <div class="azioni">
              <button class="bottone" type="submit" data-frase-salva>Salva la frase</button>
              <button class="secondario" type="button" data-frase-annulla hidden>Annulla</button>
            </div>
          </form>
          <div>
            <h2>Sul sito ne compare una alla volta</h2>
            <ol class="lista" data-lista-frasi></ol>
          </div>
        </div>
      </div>

      <!-- Testimonials -->
      <div role="tabpanel" id="p-testimonianze" aria-labelledby="t-testimonianze" data-pannello="testimonianze" hidden>
        <div class="adm-griglia">
          <form class="adm-form" data-form-testimonianza novalidate>
            <h2 data-test-titolo>Nuova testimonianza</h2>
            <p class="facoltativo">Solo parole vere, con il permesso di chi le ha scritte. Sul sito la sezione compare quando ce n'è almeno una.</p>
            <input type="hidden" name="id" />
            <div class="campo">
              <label for="te-testo">Cosa hanno detto</label>
              <textarea id="te-testo" name="testo" rows="4" maxlength="600" required></textarea>
            </div>
            <div class="campo">
              <label for="te-chi">Chi</label>
              <input id="te-chi" name="chi" type="text" maxlength="80" required placeholder="Giulia e Marco" />
            </div>
            <div class="campo">
              <label for="te-occasione">Occasione <span class="facoltativo">(facoltativa)</span></label>
              <input id="te-occasione" name="occasione" type="text" maxlength="80" placeholder="Matrimonio, giugno 2025" />
            </div>
            <label class="spunta"><input type="checkbox" name="pubblicata" checked /> <span>Mostra sul sito</span></label>
            <div class="azioni">
              <button class="bottone" type="submit" data-test-salva>Salva</button>
              <button class="secondario" type="button" data-test-annulla hidden>Annulla</button>
            </div>
          </form>
          <div>
            <h2>Testimonianze</h2>
            <ol class="lista" data-lista-testimonianze></ol>
          </div>
        </div>
      </div>

      <!-- Hall of fame -->
      <div role="tabpanel" id="p-ospiti" aria-labelledby="t-ospiti" data-pannello="ospiti" hidden>
        <div class="adm-griglia">
          <form class="adm-form" data-form-ospite novalidate>
            <h2 data-ospite-titolo>Nuovo ospite</h2>
            <p class="facoltativo">Chi è salito sul palco con voi. Solo con il suo permesso: nome, soprannome e foto compaiono sul sito.</p>
            <input type="hidden" name="id" />
            <div class="campo">
              <label for="os-nome">Nome o soprannome</label>
              <input id="os-nome" name="nome" type="text" maxlength="80" required />
            </div>
            <div class="campo">
              <label for="os-cosa">Cosa ha fatto <span class="facoltativo">(facoltativo, es. "armonica su Rino Gaetano")</span></label>
              <input id="os-cosa" name="cosa" type="text" maxlength="80" />
            </div>
            <div class="campo">
              <label for="os-quando">Quando e dove <span class="facoltativo">(facoltativo, es. "Panificio, ottobre 2023")</span></label>
              <input id="os-quando" name="quando" type="text" maxlength="80" />
            </div>
            <div class="campo">
              <label for="os-ig">Instagram <span class="facoltativo">(facoltativo, senza la @)</span></label>
              <input id="os-ig" name="instagram" type="text" maxlength="30" pattern="[A-Za-z0-9._]+" />
            </div>
            <div class="campo">
              <label for="os-foto">Foto <span class="facoltativo">(facoltativa: sul sito è un quadratino in bianco e nero)</span></label>
              <input id="os-foto" name="foto" type="file" accept="image/*" />
            </div>
            <label class="spunta"><input type="checkbox" name="pubblicato" checked /> <span>Mostra sul sito</span></label>
            <div class="azioni">
              <button class="bottone" type="submit">Salva</button>
              <button class="secondario" type="button" data-ospite-annulla hidden>Annulla</button>
            </div>
          </form>
          <div>
            <h2>Albo d'oro</h2>
            <ol class="lista" data-lista-ospiti></ol>
          </div>
        </div>
      </div>

      <!-- Collaborators -->
      <div role="tabpanel" id="p-collab" aria-labelledby="t-collab" data-pannello="collab" hidden>
        <div class="adm-griglia">
          <form class="adm-form" data-form-collab novalidate>
            <h2 data-collab-titolo>Nuovo collaboratore</h2>
            <p class="facoltativo">Solo con il loro permesso. I DJ compaiono anche nel modulo, per matrimoni ed eventi aziendali.</p>
            <input type="hidden" name="id" />
            <div class="campo">
              <label for="co-cat">Categoria</label>
              <select id="co-cat" name="categoria" required>
                <option value="dj">DJ</option>
                <option value="grafica">Grafica e disegni</option>
                <option value="foto_video">Foto e video</option>
                <option value="musicisti">Altri musicisti</option>
                <option value="locali">Locali amici</option>
              </select>
            </div>
            <div class="campo">
              <label for="co-nome">Nome</label>
              <input id="co-nome" name="nome" type="text" maxlength="80" required />
            </div>
            <div class="campo">
              <label for="co-desc">Due righe <span class="facoltativo">(facoltative, es. "house e anni '80, per far ballare tutti")</span></label>
              <textarea id="co-desc" name="descrizione" rows="2" maxlength="280"></textarea>
            </div>
            <div class="due">
              <div class="campo">
                <label for="co-citta">Città <span class="facoltativo">(facoltativa)</span></label>
                <input id="co-citta" name="citta" type="text" maxlength="80" />
              </div>
              <div class="campo">
                <label for="co-ordine">Ordine <span class="facoltativo">(i più bassi prima)</span></label>
                <input id="co-ordine" name="ordine" type="number" value="0" />
              </div>
            </div>
            <div class="campo">
              <label for="co-ig">Instagram <span class="facoltativo">(facoltativo, senza la @)</span></label>
              <input id="co-ig" name="instagram" type="text" maxlength="30" />
            </div>
            <div class="campo">
              <label for="co-sito">Sito <span class="facoltativo">(facoltativo, inizia con https://)</span></label>
              <input id="co-sito" name="sito" type="url" />
            </div>
            <div class="campo">
              <label for="co-foto">Foto o logo <span class="facoltativo">(facoltativa: sul sito è un quadrato in bianco e nero)</span></label>
              <input id="co-foto" name="foto" type="file" accept="image/*" />
            </div>
            <label class="spunta"><input type="checkbox" name="pubblicato" checked /> <span>Mostra sul sito</span></label>
            <div class="azioni">
              <button class="bottone" type="submit">Salva</button>
              <button class="secondario" type="button" data-collab-annulla hidden>Annulla</button>
            </div>
          </form>
          <div>
            <h2>Collaboratori</h2>
            <ol class="lista" data-lista-collab></ol>
          </div>
        </div>
      </div>

      <!-- Merch -->
      <div role="tabpanel" id="p-merch" aria-labelledby="t-merch" data-pannello="merch" hidden>
        <div class="adm-griglia">
          <form class="adm-form" data-form-merch novalidate>
            <h2 data-merch-titolo>Nuovo articolo</h2>
            <input type="hidden" name="id" />
            <div class="campo">
              <label for="me-nome">Nome</label>
              <input id="me-nome" name="nome" type="text" maxlength="80" required />
            </div>
            <div class="campo">
              <label for="me-desc">Due righe <span class="facoltativo">(facoltative: colore, materiale, com'è)</span></label>
              <textarea id="me-desc" name="descrizione" rows="3" maxlength="400"></textarea>
            </div>
            <div class="due">
              <div class="campo">
                <label for="me-prezzo">Prezzo in € <span class="facoltativo">(vuoto = "in arrivo")</span></label>
                <input id="me-prezzo" name="prezzo" type="number" min="0" step="0.5" inputmode="decimal" />
              </div>
              <div class="campo">
                <label for="me-ordine">Ordine</label>
                <input id="me-ordine" name="ordine" type="number" value="0" />
              </div>
            </div>
            <div class="campo">
              <label for="me-taglie">Taglie <span class="facoltativo">(separate da virgola, es. S, M, L, XL; vuoto = taglia unica)</span></label>
              <input id="me-taglie" name="taglie" type="text" />
            </div>
            <div class="campo">
              <label for="me-artista">Grafica di <span class="facoltativo">(da Collab)</span></label>
              <select id="me-artista" name="artista_id"><option value="">Nessuno</option></select>
            </div>
            <label class="spunta"><input type="checkbox" name="esaurito" /> <span>Esaurito</span></label>
            <label class="spunta"><input type="checkbox" name="pubblicato" checked /> <span>Mostra sul sito</span></label>
            <div class="azioni">
              <button class="bottone" type="submit">Salva l'articolo</button>
              <button class="secondario" type="button" data-merch-annulla hidden>Annulla</button>
            </div>

            <div class="merch-foto" data-merch-foto hidden>
              <h3>Foto di questo articolo</h3>
              <ol class="griglia-foto" data-merch-foto-lista></ol>
              <div class="campo">
                <label for="me-file">Aggiungi foto <span class="facoltativo">(anche più di una; la prima è quella che si vede subito)</span></label>
                <input id="me-file" type="file" accept="image/*" multiple data-merch-file />
              </div>
              <p class="progresso" aria-live="polite" data-merch-progresso></p>
            </div>
          </form>
          <div>
            <h2>Articoli</h2>
            <ol class="lista" data-lista-merch></ol>
          </div>
        </div>
      </div>

      <!-- Booking requests -->
      <div role="tabpanel" id="p-richieste" aria-labelledby="t-richieste" data-pannello="richieste" hidden>
        <h2>Richieste di ingaggio</h2>
        <ol class="richieste" data-lista-richieste></ol>
      </div>
    </section>
  </main>
</Base>

<script>
  import { createClient, type SupabaseClient } from '@supabase/supabase-js';
  import { PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';
  import { TIPI } from '../../lib/richiesta';

  type Concerto = {
    id: string; data: string; ora: string | null; citta: string; locale: string | null;
    link: string | null; privato: boolean; pubblicato: boolean; note: string | null;
    lat: number | null; lng: number | null;
  };

  /** City → coordinates, from OpenStreetMap (only the city name leaves the browser). */
  async function trovaCitta(citta: string): Promise<{ lat: number; lng: number } | null> {
    try {
      const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=it&city=${encodeURIComponent(citta)}`;
      const r = await fetch(url, { headers: { 'Accept-Language': 'it' } });
      const [primo] = await r.json();
      return primo ? { lat: Number(primo.lat), lng: Number(primo.lon) } : null;
    } catch {
      return null;
    }
  }
  type Richiesta = {
    id: string; tipo: keyof typeof TIPI; data_evento: string | null; luogo: string; persone: number | null;
    nome: string; contatto: string; messaggio: string | null; dj: boolean; dj_tipo: 'chambers' | 'collab' | null; dj_collab: string | null; stato: string; created_at: string;
  };

  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const msg = (t: string, errore = false) => {
    const m = $('.adm-msg');
    m.textContent = t;
    m.classList.toggle('errore', errore);
    if (t && !errore) setTimeout(() => { if (m.textContent === t) m.textContent = ''; }, 5000);
  };
  const vista = (nome: string) => {
    for (const v of document.querySelectorAll<HTMLElement>('[data-vista]')) v.hidden = v.dataset.vista !== nome;
    $('[data-esci]').hidden = nome !== 'pannello';
  };
  const giorno = (iso: string) =>
    new Date(`${iso}T12:00:00`).toLocaleDateString('it-IT', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
  const oggi = () => new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Rome' });

  if (!PUBLIC_SUPABASE_URL || !PUBLIC_SUPABASE_ANON_KEY) {
    vista('non-configurato');
  } else {
    const sb: SupabaseClient = createClient(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY);
    avvia(sb);
  }

  async function avvia(sb: SupabaseClient) {
    const entra = async () => {
      const { data } = await sb.auth.getSession();
      if (!data.session) return vista('login');
      const { data: s } = await sb.from('staff').select('ruolo').eq('user_id', data.session.user.id).maybeSingle();
      if (!s) {
        await sb.auth.signOut();
        msg('Questo account non è abilitato al pannello.', true);
        return vista('login');
      }
      vista('pannello');
      await Promise.all([caricaDate(), caricaRichieste(), caricaFoto(), caricaFrasi(), caricaTestimonianze(), caricaOspiti(), caricaCollab(), caricaMerch()]);
    };

    $('[data-login]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target as HTMLFormElement);
      const { error } = await sb.auth.signInWithPassword({ email: String(f.get('email')), password: String(f.get('password')) });
      if (error) return msg('Email o password sbagliate.', true);
      msg('');
      entra();
    });
    $('[data-esci]').addEventListener('click', async () => {
      await sb.auth.signOut();
      vista('login');
    });

    // Tabs
    for (const t of document.querySelectorAll<HTMLButtonElement>('[data-scheda]')) {
      t.addEventListener('click', () => {
        for (const x of document.querySelectorAll<HTMLButtonElement>('[data-scheda]')) x.setAttribute('aria-selected', String(x === t));
        for (const p of document.querySelectorAll<HTMLElement>('[data-pannello]')) p.hidden = p.dataset.pannello !== t.dataset.scheda;
      });
    }

    // ---------- Dates ----------
    const form = $<HTMLFormElement>('[data-form-data]');
    let concerti: Concerto[] = [];

    const svuota = () => {
      form.reset();
      (form.elements.namedItem('id') as HTMLInputElement).value = '';
      $('[data-form-titolo]').textContent = 'Nuova data';
      $('[data-salva]').textContent = 'Salva la data';
      $('[data-annulla]').hidden = true;
    };
    $('[data-annulla]').addEventListener('click', svuota);

    const riga = (c: Concerto) => `
      <li class="voce${c.pubblicato ? '' : ' nascosta'}">
        <div>
          <strong>${esc(giorno(c.data))}${c.ora ? ` · ${esc(c.ora.slice(0, 5))}` : ''}</strong>
          <span>${esc(c.locale ? `${c.locale}, ${c.citta}` : c.citta)}</span>
          <span class="etichette">${c.privato ? '<em>Festa privata</em>' : ''}${c.pubblicato ? '' : '<em>Non sul sito</em>'}${c.note ? '<em>Note</em>' : ''}</span>
        </div>
        <div class="voce-azioni">
          <button type="button" class="secondario" data-modifica="${c.id}">Modifica</button>
          <button type="button" class="secondario pericolo" data-elimina="${c.id}">Elimina</button>
        </div>
      </li>`;

    async function caricaDate() {
