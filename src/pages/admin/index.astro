---
// Band panel: sign in, manage gig dates, read and triage booking requests.
// Everything runs in the browser with the user's Supabase session, protected by RLS.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
---

<Base title="Pannello · Mari sugli alberi" description="Pannello della band." noindex>
  <header class="adm-barra">
    <div class="wrap adm-barra-dentro">
      <a class="adm-logo" href="/" aria-label="Vai al sito"><Logo /></a>
      <span class="adm-titolo">Pannello</span>
      <button type="button" class="adm-esci" data-esci hidden>Esci</button>
    </div>
  </header>

  <main id="contenuto" class="wrap adm">
    <p class="adm-msg" role="status" aria-live="polite"></p>

    <section data-vista="non-configurato" hidden>
      <h1>Pannello non ancora attivo</h1>
      <p>Supabase non è collegato: mancano le variabili <code>PUBLIC_SUPABASE_URL</code> e <code>PUBLIC_SUPABASE_ANON_KEY</code>. Vedi <code>SETUP.md</code>.</p>
    </section>

    <section data-vista="login" hidden>
      <h1>Entra</h1>
      <form class="adm-form adm-login" data-login>
        <div class="campo">
          <label for="l-email">Email</label>
          <input id="l-email" name="email" type="email" autocomplete="username" required />
        </div>
        <div class="campo">
          <label for="l-password">Password</label>
          <input id="l-password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <button class="bottone" type="submit">Entra</button>
      </form>
    </section>

    <section data-vista="pannello" hidden>
      <div class="schede" role="tablist" aria-label="Sezioni del pannello">
        <button type="button" role="tab" id="t-date" aria-controls="p-date" aria-selected="true" data-scheda="date">Date</button>
        <button type="button" role="tab" id="t-richieste" aria-controls="p-richieste" aria-selected="false" data-scheda="richieste">
          Richieste <span class="badge" data-badge hidden></span>
        </button>
        <button type="button" role="tab" id="t-foto" aria-controls="p-foto" aria-selected="false" data-scheda="foto">Foto</button>
        <button type="button" role="tab" id="t-frasi" aria-controls="p-frasi" aria-selected="false" data-scheda="frasi">Frasi</button>
        <button type="button" role="tab" id="t-testimonianze" aria-controls="p-testimonianze" aria-selected="false" data-scheda="testimonianze">Testimonianze</button>
      </div>

      <!-- Dates -->
      <div role="tabpanel" id="p-date" aria-labelledby="t-date" data-pannello="date">
        <div class="adm-griglia">
          <form class="adm-form" data-form-data novalidate>
            <h2 data-form-titolo>Nuova data</h2>
            <input type="hidden" name="id" />
            <div class="due">
              <div class="campo">
                <label for="d-data">Giorno</label>
                <input id="d-data" name="data" type="date" required />
              </div>
              <div class="campo">
                <label for="d-ora">Ora <span class="facoltativo">(facoltativa)</span></label>
                <input id="d-ora" name="ora" type="time" />
              </div>
            </div>
            <div class="campo">
              <label for="d-citta">Città</label>
              <input id="d-citta" name="citta" type="text" required maxlength="80" />
            </div>
            <div class="campo">
              <label for="d-locale">Locale <span class="facoltativo">(non si vede se è una festa privata)</span></label>
              <input id="d-locale" name="locale" type="text" maxlength="120" />
            </div>
            <div class="campo">
              <label for="d-link">Link all'evento <span class="facoltativo">(facoltativo, inizia con https://)</span></label>
              <input id="d-link" name="link" type="url" placeholder="https://www.instagram.com/p/…" />
            </div>
            <label class="spunta"><input type="checkbox" name="privato" /> <span>Festa privata (sul sito: solo città e "Festa privata")</span></label>
            <label class="spunta"><input type="checkbox" name="pubblicato" checked /> <span>Mostra sul sito</span></label>
            <div class="campo">
              <label for="d-note">Note interne <span class="facoltativo">(non si vedono mai sul sito)</span></label>
              <textarea id="d-note" name="note" rows="3" maxlength="2000"></textarea>
            </div>
            <div class="azioni">
              <button class="bottone" type="submit" data-salva>Salva la data</button>
              <button class="secondario" type="button" data-annulla hidden>Annulla</button>
            </div>
          </form>

          <div>
            <h2>Prossime</h2>
            <ol class="lista" data-lista-prossime></ol>
            <h2 class="spazio">Passate</h2>
            <ol class="lista" data-lista-passate></ol>
          </div>
        </div>
      </div>

      <!-- Photos -->
      <div role="tabpanel" id="p-foto" aria-labelledby="t-foto" data-pannello="foto" hidden>
        <form class="adm-form carica" data-carica>
          <h2>Carica foto</h2>
          <div class="campo">
            <label for="f-file">Scegli una o più foto</label>
            <input id="f-file" name="file" type="file" accept="image/*" multiple required />
            <p class="facoltativo">Vengono ridimensionate sul tuo dispositivo prima di caricarle (circa 300 KB l'una), quindi vanno bene anche quelle grandi del telefono.</p>
          </div>
          <div class="campo">
            <label for="f-alt">Descrizione per chi non vede <span class="facoltativo">(facoltativa, vale per tutte le foto di questo caricamento)</span></label>
            <input id="f-alt" name="alt" type="text" maxlength="300" placeholder="Foto dal vivo di Mari sugli alberi" />
          </div>
          <div class="azioni">
            <button class="bottone" type="submit" data-carica-invia>Carica</button>
            <p class="progresso" aria-live="polite" data-progresso></p>
          </div>
        </form>
        <h2 class="spazio">Nella galleria <span class="facoltativo" data-conta-foto></span></h2>
        <ol class="griglia-foto" data-lista-foto></ol>
      </div>

      <!-- Famous lines -->
      <div role="tabpanel" id="p-frasi" aria-labelledby="t-frasi" data-pannello="frasi" hidden>
        <div class="adm-griglia">
          <form class="adm-form" data-form-frase novalidate>
            <h2 data-frase-titolo>Nuova frase</h2>
            <input type="hidden" name="id" />
            <div class="campo">
              <label for="fr-testo">La frase</label>
              <textarea id="fr-testo" name="testo" rows="3" maxlength="280" required></textarea>
            </div>
            <div class="campo">
              <label for="fr-chi">Chi l'ha detta <span class="facoltativo">(vuoto = la band; i fan solo con il loro permesso)</span></label>
              <input id="fr-chi" name="chi" type="text" maxlength="80" />
            </div>
            <label class="spunta"><input type="checkbox" name="pubblicata" checked /> <span>Mostra sul sito</span></label>
            <div class="azioni">
              <button class="bottone" type="submit" data-frase-salva>Salva la frase</button>
              <button class="secondario" type="button" data-frase-annulla hidden>Annulla</button>
            </div>
          </form>
          <div>
            <h2>Sul sito ne compare una alla volta</h2>
            <ol class="lista" data-lista-frasi></ol>
          </div>
        </div>
      </div>

      <!-- Testimonials -->
      <div role="tabpanel" id="p-testimonianze" aria-labelledby="t-testimonianze" data-pannello="testimonianze" hidden>
        <div class="adm-griglia">
          <form class="adm-form" data-form-testimonianza novalidate>
            <h2 data-test-titolo>Nuova testimonianza</h2>
            <p class="facoltativo">Solo parole vere, con il permesso di chi le ha scritte. Sul sito la sezione compare quando ce n'è almeno una.</p>
            <input type="hidden" name="id" />
            <div class="campo">
              <label for="te-testo">Cosa hanno detto</label>
              <textarea id="te-testo" name="testo" rows="4" maxlength="600" required></textarea>
            </div>
            <div class="campo">
              <label for="te-chi">Chi</label>
              <input id="te-chi" name="chi" type="text" maxlength="80" required placeholder="Giulia e Marco" />
            </div>
            <div class="campo">
              <label for="te-occasione">Occasione <span class="facoltativo">(facoltativa)</span></label>
              <input id="te-occasione" name="occasione" type="text" maxlength="80" placeholder="Matrimonio, giugno 2025" />
            </div>
            <label class="spunta"><input type="checkbox" name="pubblicata" checked /> <span>Mostra sul sito</span></label>
            <div class="azioni">
              <button class="bottone" type="submit" data-test-salva>Salva</button>
              <button class="secondario" type="button" data-test-annulla hidden>Annulla</button>
            </div>
          </form>
          <div>
            <h2>Testimonianze</h2>
            <ol class="lista" data-lista-testimonianze></ol>
          </div>
        </div>
      </div>

      <!-- Booking requests -->
      <div role="tabpanel" id="p-richieste" aria-labelledby="t-richieste" data-pannello="richieste" hidden>
        <h2>Richieste di ingaggio</h2>
        <ol class="richieste" data-lista-richieste></ol>
      </div>
    </section>
  </main>
</Base>

<script>
  import { createClient, type SupabaseClient } from '@supabase/supabase-js';
  import { PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';
  import { TIPI } from '../../lib/richiesta';

  type Concerto = {
    id: string; data: string; ora: string | null; citta: string; locale: string | null;
    link: string | null; privato: boolean; pubblicato: boolean; note: string | null;
  };
  type Richiesta = {
    id: string; tipo: keyof typeof TIPI; data_evento: string | null; luogo: string; persone: number | null;
    nome: string; contatto: string; messaggio: string | null; dj: boolean; stato: string; created_at: string;
  };

  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const msg = (t: string, errore = false) => {
    const m = $('.adm-msg');
    m.textContent = t;
    m.classList.toggle('errore', errore);
    if (t && !errore) setTimeout(() => { if (m.textContent === t) m.textContent = ''; }, 5000);
  };
  const vista = (nome: string) => {
    for (const v of document.querySelectorAll<HTMLElement>('[data-vista]')) v.hidden = v.dataset.vista !== nome;
    $('[data-esci]').hidden = nome !== 'pannello';
  };
  const giorno = (iso: string) =>
    new Date(`${iso}T12:00:00`).toLocaleDateString('it-IT', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
  const oggi = () => new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Rome' });

  if (!PUBLIC_SUPABASE_URL || !PUBLIC_SUPABASE_ANON_KEY) {
    vista('non-configurato');
  } else {
    const sb: SupabaseClient = createClient(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY);
    avvia(sb);
  }

  async function avvia(sb: SupabaseClient) {
    const entra = async () => {
      const { data } = await sb.auth.getSession();
      if (!data.session) return vista('login');
      const { data: s } = await sb.from('staff').select('ruolo').eq('user_id', data.session.user.id).maybeSingle();
      if (!s) {
        await sb.auth.signOut();
        msg('Questo account non è abilitato al pannello.', true);
        return vista('login');
      }
      vista('pannello');
      await Promise.all([caricaDate(), caricaRichieste(), caricaFoto(), caricaFrasi(), caricaTestimonianze()]);
    };

    $('[data-login]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target as HTMLFormElement);
      const { error } = await sb.auth.signInWithPassword({ email: String(f.get('email')), password: String(f.get('password')) });
      if (error) return msg('Email o password sbagliate.', true);
      msg('');
      entra();
    });
    $('[data-esci]').addEventListener('click', async () => {
      await sb.auth.signOut();
      vista('login');
    });

    // Tabs
    for (const t of document.querySelectorAll<HTMLButtonElement>('[data-scheda]')) {
      t.addEventListener('click', () => {
        for (const x of document.querySelectorAll<HTMLButtonElement>('[data-scheda]')) x.setAttribute('aria-selected', String(x === t));
        for (const p of document.querySelectorAll<HTMLElement>('[data-pannello]')) p.hidden = p.dataset.pannello !== t.dataset.scheda;
      });
    }

    // ---------- Dates ----------
    const form = $<HTMLFormElement>('[data-form-data]');
    let concerti: Concerto[] = [];

    const svuota = () => {
      form.reset();
      (form.elements.namedItem('id') as HTMLInputElement).value = '';
      $('[data-form-titolo]').textContent = 'Nuova data';
      $('[data-salva]').textContent = 'Salva la data';
      $('[data-annulla]').hidden = true;
    };
    $('[data-annulla]').addEventListener('click', svuota);

    const riga = (c: Concerto) => `
      <li class="voce${c.pubblicato ? '' : ' nascosta'}">
        <div>
          <strong>${esc(giorno(c.data))}${c.ora ? ` · ${esc(c.ora.slice(0, 5))}` : ''}</strong>
          <span>${esc(c.locale ? `${c.locale}, ${c.citta}` : c.citta)}</span>
          <span class="etichette">${c.privato ? '<em>Festa privata</em>' : ''}${c.pubblicato ? '' : '<em>Non sul sito</em>'}${c.note ? '<em>Note</em>' : ''}</span>
        </div>
        <div class="voce-azioni">
          <button type="button" class="secondario" data-modifica="${c.id}">Modifica</button>
          <button type="button" class="secondario pericolo" data-elimina="${c.id}">Elimina</button>
        </div>
      </li>`;

    async function caricaDate() {
      const { data, error } = await sb.from('concerti').select('*').order('data').order('ora');
      if (error) return msg(`Non riesco a leggere le date: ${error.message}`, true);
      concerti = data as Concerto[];
      const o = oggi();
      const prossime = concerti.filter((c) => c.data >= o);
      const passate = concerti.filter((c) => c.data < o).reverse();
      $('[data-lista-prossime]').innerHTML = prossime.map(riga).join('') || '<li class="vuota">Nessuna data in programma.</li>';
      $('[data-lista-passate]').innerHTML = passate.map(riga).join('') || '<li class="vuota">Ancora nessuna.</li>';
    }

    document.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-modifica],[data-elimina]');
      if (!b) return;
      const id = b.dataset.modifica ?? b.dataset.elimina!;
      const c = concerti.find((x) => x.id === id);
      if (!c) return;
      if (b.dataset.modifica) {
        const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
        el('id').value = c.id;
        el('data').value = c.data;
        el('ora').value = c.ora?.slice(0, 5) ?? '';
        el('citta').value = c.citta;
        el('locale').value = c.locale ?? '';
        el('link').value = c.link ?? '';
        el('privato').checked = c.privato;
        el('pubblicato').checked = c.pubblicato;
        (form.elements.namedItem('note') as HTMLTextAreaElement).value = c.note ?? '';
        $('[data-form-titolo]').textContent = 'Modifica la data';
        $('[data-salva]').textContent = 'Salva le modifiche';
        $('[data-annulla]').hidden = false;
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        el('data').focus();
      } else {
        if (!confirm(`Eliminare la data del ${giorno(c.data)} a ${c.citta}? Non si può annullare.`)) return;
        const { error } = await sb.from('concerti').delete().eq('id', c.id);
        if (error) return msg(`Non riesco a eliminarla: ${error.message}`, true);
        msg('Data eliminata.');
        caricaDate();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const t = (k: string) => String(f.get(k) ?? '').trim();
      const link = t('link');
      if (!t('data')) return msg('Manca il giorno.', true);
      if (t('citta').length < 2) return msg('Manca la città.', true);
      if (link && !link.startsWith('https://')) return msg('Il link deve iniziare con https://', true);
      const riga = {
        data: t('data'),
        ora: t('ora') || null,
        citta: t('citta'),
        locale: t('locale') || null,
        link: link || null,
        privato: f.get('privato') === 'on',
        pubblicato: f.get('pubblicato') === 'on',
        note: t('note') || null,
      };
      const id = t('id');
      const { error } = id ? await sb.from('concerti').update(riga).eq('id', id) : await sb.from('concerti').insert(riga);
      if (error) return msg(`Non riesco a salvare: ${error.message}`, true);
      msg(id ? 'Modifiche salvate. Sul sito compaiono entro un minuto.' : 'Data aggiunta. Sul sito compare entro un minuto.');
      svuota();
      caricaDate();
    });

    // ---------- Booking requests ----------
    const STATI = ['nuova', 'risposta', 'confermata', 'scartata'];
    async function caricaRichieste() {
      const { data, error } = await sb.from('richieste').select('*').order('created_at', { ascending: false });
      if (error) return msg(`Non riesco a leggere le richieste: ${error.message}`, true);
      const r = data as Richiesta[];
      const nuove = r.filter((x) => x.stato === 'nuova').length;
      const badge = $('[data-badge]');
      badge.textContent = String(nuove);
      badge.hidden = nuove === 0;
      $('[data-lista-richieste]').innerHTML = r.map((x) => {
        const contatto = x.contatto.includes('@')
          ? `<a href="mailto:${esc(x.contatto)}">${esc(x.contatto)}</a>`
          : `<a href="tel:${esc(x.contatto.replace(/[^\d+]/g, ''))}">${esc(x.contatto)}</a>`;
        return `
        <li class="richiesta stato-${esc(x.stato)}">
          <div class="richiesta-testa">
            <strong>${x.stato === 'nuova' ? '<span class="nuova-tag">Nuova</span>' : ''}${esc(TIPI[x.tipo] ?? x.tipo)} · ${esc(x.luogo)}</strong>
            <label>Stato
              <select data-stato="${x.id}">
                ${STATI.map((s) => `<option value="${s}"${s === x.stato ? ' selected' : ''}>${s}</option>`).join('')}
              </select>
            </label>
          </div>
          <dl>
            <div><dt>Quando</dt><dd>${x.data_evento ? esc(giorno(x.data_evento)) : 'da decidere'}</dd></div>
            <div><dt>Persone</dt><dd>${x.persone ?? '—'}</dd></div>
            <div><dt>DJ set</dt><dd>${x.dj ? 'sì' : 'no'}</dd></div>
            <div><dt>Chi</dt><dd>${esc(x.nome)} · ${contatto}</dd></div>
            <div><dt>Arrivata</dt><dd>${esc(new Date(x.created_at).toLocaleString('it-IT', { dateStyle: 'medium', timeStyle: 'short' }))}</dd></div>
          </dl>
          ${x.messaggio ? `<p class="richiesta-msg">${esc(x.messaggio)}</p>` : ''}
        </li>`;
      }).join('') || '<li class="vuota">Nessuna richiesta, per ora.</li>';
    }

    document.addEventListener('change', async (e) => {
      const s = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-stato]');
      if (!s) return;
      const { error } = await sb.from('richieste').update({ stato: s.value }).eq('id', s.dataset.stato!);
      if (error) return msg(`Non riesco a cambiare lo stato: ${error.message}`, true);
      msg('Stato aggiornato.');
      caricaRichieste();
    });

    // ---------- Photos ----------
    type FotoRiga = { id: string; path: string; thumb_path: string; alt: string | null; pubblicata: boolean };
    const urlFoto = (p: string) => `${PUBLIC_SUPABASE_URL}/storage/v1/object/public/foto/${p}`;
    let foto: FotoRiga[] = [];

    async function ridimensiona(img: ImageBitmap, lato: number, qualita: number) {
      const k = Math.min(1, lato / Math.max(img.width, img.height));
      const w = Math.round(img.width * k), h = Math.round(img.height * k);
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const ctx = c.getContext('2d')!;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, 0, 0, w, h);
      let blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/webp', qualita));
      if (!blob || blob.type !== 'image/webp') blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', qualita + 0.05));
      if (!blob) throw new Error('conversione non riuscita');
      return { blob, w, h, ext: blob.type === 'image/webp' ? 'webp' : 'jpg' };
    }

    async function caricaFoto() {
      const { data, error } = await sb.from('foto').select('id,path,thumb_path,alt,pubblicata').order('created_at', { ascending: false });
      if (error) return msg(`Non riesco a leggere le foto: ${error.message}`, true);
      foto = data as FotoRiga[];
      $('[data-conta-foto]').textContent = `(${foto.filter((f) => f.pubblicata).length} visibili su ${foto.length})`;
      $('[data-lista-foto]').innerHTML = foto.map((f) => `
        <li class="${f.pubblicata ? '' : 'nascosta'}">
          <img src="${esc(urlFoto(f.thumb_path))}" alt="${esc(f.alt ?? '')}" loading="lazy" />
          <div class="foto-azioni">
            <button type="button" class="secondario" data-foto-mostra="${f.id}">${f.pubblicata ? 'Nascondi' : 'Mostra'}</button>
            <button type="button" class="secondario pericolo" data-foto-elimina="${f.id}">Elimina</button>
          </div>
        </li>`).join('') || '<li class="vuota">Ancora nessuna foto.</li>';
    }

    $('[data-carica]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formFoto = e.target as HTMLFormElement;
      const files = [...(formFoto.elements.namedItem('file') as HTMLInputElement).files ?? []];
      const alt = (formFoto.elements.namedItem('alt') as HTMLInputElement).value.trim() || null;
      if (!files.length) return msg('Scegli almeno una foto.', true);
      const bottone = $<HTMLButtonElement>('[data-carica-invia]');
      const progresso = $('[data-progresso]');
      bottone.disabled = true;
      let fatte = 0, fallite = 0;
      for (const file of files) {
        progresso.textContent = `Carico ${fatte + fallite + 1} di ${files.length}…`;
        try {
          const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
          const [g, t] = [await ridimensiona(bmp, 2048, 0.82), await ridimensiona(bmp, 640, 0.72)];
          bmp.close();
          const base = `${new Date().getFullYear()}/${crypto.randomUUID()}`;
          const path = `${base}.${g.ext}`, thumb = `${base}-mini.${t.ext}`;
          const opt = { cacheControl: '31536000', upsert: false };
          const [a, b] = await Promise.all([
            sb.storage.from('foto').upload(path, g.blob, { ...opt, contentType: g.blob.type }),
            sb.storage.from('foto').upload(thumb, t.blob, { ...opt, contentType: t.blob.type }),
          ]);
          if (a.error || b.error) throw a.error ?? b.error;
          const { error } = await sb.from('foto').insert({ path, thumb_path: thumb, width: g.w, height: g.h, thumb_width: t.w, thumb_height: t.h, alt });
          if (error) {
            await sb.storage.from('foto').remove([path, thumb]);
            throw error;
          }
          fatte++;
        } catch (err) {
          console.error('caricamento foto', err);
          fallite++;
        }
      }
      bottone.disabled = false;
      progresso.textContent = '';
      formFoto.reset();
      msg(fallite ? `Caricate ${fatte}, non riuscite ${fallite}.` : `Caricate ${fatte} foto. Sul sito compaiono entro un minuto.`, fallite > 0);
      caricaFoto();
    });

    document.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-foto-mostra],[data-foto-elimina]');
      if (!b) return;
      const f = foto.find((x) => x.id === (b.dataset.fotoMostra ?? b.dataset.fotoElimina));
      if (!f) return;
      if (b.dataset.fotoMostra) {
        const { error } = await sb.from('foto').update({ pubblicata: !f.pubblicata }).eq('id', f.id);
        if (error) return msg(`Non riesco a cambiarla: ${error.message}`, true);
        msg(f.pubblicata ? 'Foto nascosta dal sito.' : 'Foto di nuovo visibile.');
      } else {
        if (!confirm('Eliminare questa foto? Non si può annullare.')) return;
        const { error } = await sb.from('foto').delete().eq('id', f.id);
        if (error) return msg(`Non riesco a eliminarla: ${error.message}`, true);
        await sb.storage.from('foto').remove([f.path, f.thumb_path]);
        msg('Foto eliminata.');
      }
      caricaFoto();
    });

    // ---------- Famous lines and testimonials: the same small editor for both ----------
    type Voce = { id: string; testo: string; chi: string | null; occasione?: string | null; pubblicata: boolean };
    function editor(cfg: {
      tabella: 'frasi' | 'testimonianze';
      form: string; lista: string; titolo: string; salva: string; annulla: string;
      nuovo: string; modifica: string; campi: string[]; vuoto: string;
      riassunto: (v: Voce) => string;
    }) {
      const f = $<HTMLFormElement>(cfg.form);
      let voci: Voce[] = [];
      const el = (n: string) => f.elements.namedItem(n) as HTMLInputElement;
      const reset = () => {
        f.reset();
        el('id').value = '';
        $(cfg.titolo).textContent = cfg.nuovo;
        $(cfg.annulla).hidden = true;
      };
      $(cfg.annulla).addEventListener('click', reset);
      const carica = async () => {
        const { data, error } = await sb.from(cfg.tabella).select('*').order('created_at', { ascending: false });
        if (error) return msg(`Non riesco a leggere: ${error.message}`, true);
        voci = data as Voce[];
        $(cfg.lista).innerHTML = voci.map((v) => `
          <li class="voce${v.pubblicata ? '' : ' nascosta'}">
            <div>${cfg.riassunto(v)}<span class="etichette">${v.pubblicata ? '' : '<em>Non sul sito</em>'}</span></div>
            <div class="voce-azioni">
              <button type="button" class="secondario" data-ed-modifica="${cfg.tabella}:${v.id}">Modifica</button>
              <button type="button" class="secondario pericolo" data-ed-elimina="${cfg.tabella}:${v.id}">Elimina</button>
            </div>
          </li>`).join('') || `<li class="vuota">${cfg.vuoto}</li>`;
      };
      document.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-ed-modifica],[data-ed-elimina]');
        if (!b) return;
        const [tab, id] = (b.dataset.edModifica ?? b.dataset.edElimina)!.split(':');
        if (tab !== cfg.tabella) return;
        const v = voci.find((x) => x.id === id);
        if (!v) return;
        if (b.dataset.edModifica) {
          el('id').value = v.id;
          for (const c of cfg.campi) (f.elements.namedItem(c) as HTMLInputElement).value = (v as any)[c] ?? '';
          el('pubblicata').checked = v.pubblicata;
          $(cfg.titolo).textContent = cfg.modifica;
          $(cfg.annulla).hidden = false;
          f.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          if (!confirm('Eliminarla? Non si può annullare.')) return;
          const { error } = await sb.from(cfg.tabella).delete().eq('id', v.id);
          if (error) return msg(`Non riesco a eliminarla: ${error.message}`, true);
          msg('Eliminata.');
          carica();
        }
      });
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const d = new FormData(f);
        const riga: Record<string, unknown> = { pubblicata: d.get('pubblicata') === 'on' };
        for (const c of cfg.campi) riga[c] = String(d.get(c) ?? '').trim() || null;
        if (!riga.testo) return msg('Manca il testo.', true);
        if (cfg.tabella === 'testimonianze' && !riga.chi) return msg('Manca chi l\'ha detto.', true);
        const id = el('id').value;
        const { error } = id ? await sb.from(cfg.tabella).update(riga).eq('id', id) : await sb.from(cfg.tabella).insert(riga);
        if (error) return msg(`Non riesco a salvare: ${error.message}`, true);
        msg('Salvato. Sul sito si vede alla prossima apertura della pagina.');
        reset();
        carica();
      });
      return carica;
    }

    const caricaFrasi = editor({
      tabella: 'frasi', form: '[data-form-frase]', lista: '[data-lista-frasi]', titolo: '[data-frase-titolo]',
      salva: '[data-frase-salva]', annulla: '[data-frase-annulla]', nuovo: 'Nuova frase', modifica: 'Modifica la frase',
      campi: ['testo', 'chi'], vuoto: 'Ancora nessuna frase.',
      riassunto: (v) => `<strong>${esc(v.testo)}</strong><span>${esc(v.chi || 'la band')}</span>`,
    });
    const caricaTestimonianze = editor({
      tabella: 'testimonianze', form: '[data-form-testimonianza]', lista: '[data-lista-testimonianze]', titolo: '[data-test-titolo]',
      salva: '[data-test-salva]', annulla: '[data-test-annulla]', nuovo: 'Nuova testimonianza', modifica: 'Modifica la testimonianza',
      campi: ['testo', 'chi', 'occasione'], vuoto: 'Ancora nessuna: sul sito la sezione resta nascosta.',
      riassunto: (v) => `<strong>«${esc(v.testo)}»</strong><span>${esc(v.chi)}${v.occasione ? ` · ${esc(v.occasione)}` : ''}</span>`,
    });

    entra();
  }
</script>

