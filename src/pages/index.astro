---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Barra from '../components/Barra.astro';
import Piede from '../components/Piede.astro';
import Freccia from '../components/Freccia.astro';
import CercaScaletta from '../components/CercaScaletta.astro';

import copertina from '../assets/foto/copertina.jpg';
import risate from '../assets/foto/risate.jpg';
import nocche from '../assets/foto/nocche.jpg';
import completo from '../assets/foto/completo-bn.jpg';
import piazzaVoce from '../assets/foto/piazza-voce.jpg';
import piazzaChitarra from '../assets/foto/piazza-chitarra.jpg';
import piazzaPercussioni from '../assets/foto/piazza-percussioni.jpg';
import piazzaBrindisi from '../assets/foto/piazza-brindisi.jpg';
import osteria from '../assets/foto/osteria.jpg';
import luceRossa from '../assets/foto/luce-rossa.jpg';
import luceVerde from '../assets/foto/luce-verde.jpg';
import osteriaUrlo from '../assets/foto/osteria-urlo.jpg';
import palcoTrio from '../assets/foto/palco-trio.jpg';
import osteriaZio from '../assets/foto/osteria-zio.jpg';
import santino from '../assets/foto/santino.jpg';

const INSTAGRAM = 'https://www.instagram.com/marisuglialberi/';

const membri: { nome: string; ruolo: string; strumento: string; instagram?: string; santino?: boolean }[] = [
  { nome: 'Giova', ruolo: 'Buongiornista', strumento: 'chitarra acustica, prima voce', instagram: 'giorigoni' },
  { nome: 'Celi', ruolo: 'Primo scalettista', strumento: 'prima chitarra acustica, seconda voce', instagram: 'f.c.elia' },
  { nome: 'Coraz', ruolo: 'Manager delle pentole', strumento: 'percussioni e batteria', instagram: 'matteo_coraz_corazza' },
  { nome: 'Chambers', ruolo: '«Lo zio»', strumento: 'fonico, service e dj. Se tutto fila liscio è grazie a lui. Un santo, un apostolo.', instagram: 'chambers.marco', santino: true },
];

const brani = [
  { codice: 'A1', tipo: 'osteria', nome: 'Bar/Osteria', nota: 'la nostra casa' },
  { codice: 'A2', tipo: 'matrimonio', nome: 'Matrimonio', nota: 'dopo la torta' },
  { codice: 'A3', tipo: 'aziendale', nome: 'Aziendale', nota: 'senza cravatta' },
  { codice: 'A4', tipo: 'salotto', nome: 'Salotto', nota: 'a casa tua' },
];

// Daylight photos go black and white; stage-lit ones keep their colour.
const striscia = [
  { src: palcoTrio, alt: 'I tre sul palco all\'aperto: Celi canta, Giova suona in giacca gialla, Coraz dietro', bn: true },
  { src: osteriaUrlo, alt: 'Giova urla nel microfono con la chitarra, in osteria, sotto le luci calde', bn: false },
  { src: osteriaZio, alt: 'Giova canta e lo zio Chambers urla con lui, birra in mano, in osteria', bn: false },
  { src: piazzaVoce, alt: 'Giova canta in piazza, sotto le foglie di un albero', bn: true },
  { src: luceRossa, alt: 'Chitarra acustica sotto una luce rossa, in osteria', bn: false },
  { src: piazzaPercussioni, alt: 'Coraz alle percussioni durante un concerto all\'aperto', bn: true },
  { src: osteria, alt: 'Concerto in osteria sotto un soffitto di legno', bn: false },
  { src: piazzaChitarra, alt: 'Un chitarrista seduto su uno sgabello, sorride mentre suona', bn: true },
  { src: luceVerde, alt: 'Coraz suona in camicia e cravatta sotto una luce verde', bn: false },
  { src: piazzaBrindisi, alt: 'Due della band ridono con un bicchiere in mano tra un pezzo e l\'altro', bn: true },
];

---

<Base
  title="Mari sugli alberi · Trio acustico di cover per osterie, matrimoni e feste"
  description="Due chitarre acustiche, una batteria e tutta la sala che canta. Cover italiane da Mina a Calcutta. Suoniamo dove vuoi tu, anche nel tuo salotto: portaci alla tua festa."
>
  <Barra />

  <main id="contenuto">
    <!-- Cover: the sleeve, with the record sliding out of it on wide screens -->
    <section class="copertina wrap" aria-labelledby="titolo">
      <div class="busta">
        <div class="disco" aria-hidden="true"><span><Logo /></span></div>
        <figure class="cover">
          <Picture
            src={copertina}
            formats={['avif', 'webp']}
            widths={[420, 720, 1080]}
            sizes="(min-width: 1024px) 560px, calc(100vw - 32px)"
            alt="Giova, Celi e Coraz in maglietta nera davanti a un muro rosso"
            loading="eager"
            fetchpriority="high"
          />
          <h1 id="titolo" class="cover-titolo">
            <Logo />
            <span class="solo-lettori">Mari sugli alberi</span>
          </h1>
        </figure>
      </div>

      <div class="retro-cover">
        <p class="claim">Due chitarre, una batteria e tutta la sala che canta. Cover italiane da Mina a Calcutta, dove vuoi tu.</p>

        <div class="tracklist-testa">
          <h2 class="tracklist-titolo" id="che-festa">Lato A: che festa è?</h2>
          <span class="tracklist-scegli" aria-hidden="true">Tocca e scegli</span>
        </div>
        <ol class="tracklist" aria-labelledby="che-festa">
          {brani.map((b) => (
            <li>
              <button type="button" class="brano" data-tipo={b.tipo} aria-pressed="false">
                <span class="brano-codice">{b.codice}</span>
                <span class="brano-nome">{b.nome}</span>
                <span class="brano-nota">{b.nota}</span>
              </button>
            </li>
          ))}
        </ol>

        <a class="bottone cta" href="#portaci" data-cta>
          <span>Portaci alla tua festa</span>
          <Freccia />
        </a>
      </div>
    </section>

    <!-- The band's motto, set large -->
    <section class="motto" aria-label="Il nostro motto">
      <div class="wrap"><p class="motto-testo">Uno spettacolo non richiesto, <span>ma che tutti vogliono.</span></p></div>
    </section>

    <!-- Side A: the formats, plus the themed show as a bonus track -->
    <section id="lato-a" class="lato-a" aria-labelledby="lato-a-titolo">
      <div class="wrap">
        <h2 id="lato-a-titolo" class="lato-titolo">Lato A <span>Per la tua festa</span></h2>
        <div class="formati">
          <article class="formato">
            <p class="formato-codice">A1</p>
            <h3>Bar/Osteria</h3>
            <p>È casa nostra. Tavoli vicini, bicchieri pieni e la gente che canta con noi. Si comincia seduti e si finisce in piedi, meno sobri di prima.</p>
          </article>
          <article class="formato">
            <p class="formato-codice">A2</p>
            <h3>Matrimonio</h3>
            <p>Ne abbiamo già fatti, e sono feste vere. Dai nonni ai cugini ventenni, le canzoni le conoscono tutti e la scaletta la facciamo assieme.</p>
          </article>
          <article class="formato">
            <p class="formato-codice">A3</p>
            <h3>Aziendale</h3>
            <p>Anche le aziende fanno festa. Ci siamo già stati e chi c'era si è divertito. Le cravatte le togliamo noi per primi.</p>
          </article>
          <article class="formato">
            <p class="formato-codice">A4</p>
            <h3>Salotto</h3>
            <p>Sposti il divano, chiami gli amici e per una sera casa tua diventa un locale. Noi portiamo le chitarre, e a volte la tequila.</p>
          </article>
        </div>

        <article class="bonus">
          <div class="bonus-foto">
            <Picture
              src={nocche}
              formats={['avif', 'webp']}
              widths={[420, 720, 1080]}
              sizes="(min-width: 1024px) 600px, calc(100vw - 32px)"
              alt="Tre pugni con le lettere di MARI SUGLI ALBERI scritte sulle nocche, in completo nero e cappello"
            />
          </div>
          <div class="bonus-testo">
            <h3><span class="formato-codice">Bonus track</span> Lo spettacolo a tema</h3>
            <p>Completo nero, cappello e occhiali scuri. Lo stesso concerto, con un altro vestito e qualche sorpresa. Lo portiamo su richiesta.</p>
            <a class="link-freccia" href="#portaci">Chiedilo nel modulo <Freccia /></a>
          </div>
        </article>

        <article class="bonus-dj">
          <h3><span class="formato-codice">Bonus track 2</span> Concerto + DJ set</h3>
          <p>Finito il concerto, lo zio Chambers passa dal mixer alla consolle e si balla fino a tardi. Ci proponiamo spesso in coppia: lo aggiungi con un tocco nel modulo.</p>
        </article>
      </div>
    </section>

    <!-- Liner notes: who we are -->
    <section id="note" class="note" aria-labelledby="note-titolo">
      <div class="wrap note-griglia">
        <div class="note-foto">
          <Picture
            src={risate}
            formats={['avif', 'webp']}
            widths={[420, 720, 1080]}
            sizes="(min-width: 1024px) 560px, calc(100vw - 32px)"
            alt="I tre della band ridono davanti al muro rosso, uno si copre gli occhiali con la mano"
          />
        </div>
        <div class="note-testo">
          <h2 id="note-titolo">Note di copertina</h2>
          <p class="note-attacco">Il primo concerto l'abbiamo fatto in un panificio. Quattro ore di musica, e un sacco di amici saliti sul palco a suonare con noi.</p>
          <p>Era ottobre 2023 ed eravamo in due. Poi siamo diventati tre sul palco, più lo zio al mixer, e lo spirito è rimasto quello: giochiamo con il pubblico, brindiamo con il pubblico, e alla fine cantano tutti.</p>
          <dl class="crediti">
            {membri.map((m) => (
              <div class:list={[{ 'con-santino': m.santino }]}>
                <dt>{m.nome}</dt>
                <dd>
                  <span class="credito-ruolo">{m.ruolo}</span>
                  <span class="credito-strumento">{m.strumento}</span>
                  {m.instagram && <a class="credito-ig" href={`https://www.instagram.com/${m.instagram}/`}>@{m.instagram}</a>}
                </dd>
                {m.santino && (
                  <button type="button" class="santino zoom" data-zoom="zoom-santino" aria-haspopup="dialog">
                    <Picture
                      src={santino}
                      formats={['avif', 'webp']}
                      widths={[160, 320]}
                      sizes="140px"
                      alt="Il santino di Chambers: lui vestito da papa, con l'aureola e il cielo azzurro. Apri l'immagine grande"
                    />
                  </button>
                )}
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Side B: for people who come to listen -->
    <section id="lato-b" class="lato-b" aria-labelledby="lato-b-titolo">
      <div class="wrap">
        <h2 id="lato-b-titolo" class="lato-titolo">Lato B <span>Per chi viene a sentirci</span></h2>

        <div class="lato-b-griglia">
          <div class="b-blocco">
            <h3><span class="formato-codice">B1</span> Prossime date</h3>
            <ol class="date" data-prossime hidden></ol>
            <p class="vuoto" data-date-vuoto>Le prossime date arrivano presto. Intanto le annunciamo su <a href={INSTAGRAM}>Instagram</a>.</p>
            <a class="link-freccia" href="/date">Tutte le date e i concerti passati <Freccia /></a>
          </div>

          <div class="b-blocco">
            <h3><span class="formato-codice">B2</span> Fate anche…?</h3>
            <CercaScaletta id="cerca-brano" richiesta="#portaci" />
          </div>
        </div>

        <h3 class="b-titolo-foto"><span class="formato-codice">B3</span> Dal vivo</h3>
      </div>
      <ul class="striscia" aria-label="Foto dai concerti">
        {striscia.map((f) => (
          <li>
            <Picture
              src={f.src}
              formats={['avif', 'webp']}
              widths={[320, 640]}
              sizes="(min-width: 1024px) 360px, 72vw"
              alt={f.alt}
              class={f.bn ? 'bn' : undefined}
            />
          </li>
        ))}
      </ul>

      <div class="wrap">
        <div class="video">
          <Picture
            src={completo}
            formats={['avif', 'webp']}
            widths={[420, 800, 1200]}
            sizes="(min-width: 1024px) 1240px, calc(100vw - 32px)"
            alt="La band in completo nero, cappello e occhiali da sole, in bianco e nero"
          />
          <div class="video-testo">
            <h3><span class="formato-codice">B4</span> Il video arriva presto</h3>
            <p>Lo stiamo montando. Intanto i pezzi dal vivo sono su Instagram.</p>
            <a class="link-freccia" href={INSTAGRAM}>Guardali su Instagram <Freccia /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- The back: the booking form -->
    <section id="portaci" class="retro" aria-labelledby="portaci-titolo">
      <div class="wrap retro-griglia">
        <div class="retro-intro">
          <h2 id="portaci-titolo">Portaci alla tua festa</h2>
          <p>Dicci che festa è, quando e dove. Ti rispondiamo noi, a mano, con le idee e un preventivo. Veniamo dove vuoi tu, anche nel tuo salotto.</p>
        </div>

        <form class="modulo" method="post" action="/api/richiesta" novalidate data-modulo>
          <fieldset class="campo campo-tipo">
            <legend>Che festa è?</legend>
            <div class="scelte">
              <label><input type="radio" name="tipo" value="osteria" required /> <span>Bar/Osteria</span></label>
              <label><input type="radio" name="tipo" value="matrimonio" /> <span>Matrimonio</span></label>
              <label><input type="radio" name="tipo" value="aziendale" /> <span>Aziendale</span></label>
              <label><input type="radio" name="tipo" value="salotto" /> <span>Salotto</span></label>
              <label><input type="radio" name="tipo" value="altro" /> <span>Altra festa</span></label>
            </div>
            <p class="errore" id="errore-tipo" data-errore="tipo"></p>
          </fieldset>

          <div class="campi-due">
            <div class="campo">
              <label for="f-data">Quando <span class="facoltativo">(se lo sai già)</span></label>
              <input id="f-data" name="data" type="date" aria-describedby="errore-data" />
              <p class="errore" id="errore-data" data-errore="data"></p>
            </div>
            <div class="campo">
              <label for="f-persone">Quante persone, più o meno</label>
              <input id="f-persone" name="persone" type="number" inputmode="numeric" min="1" max="5000" aria-describedby="errore-persone" />
              <p class="errore" id="errore-persone" data-errore="persone"></p>
            </div>
          </div>

          <div class="campo">
            <label for="f-luogo">Dove</label>
            <input id="f-luogo" name="luogo" type="text" autocomplete="address-level2" placeholder="Città, e il locale se c'è già" required aria-describedby="errore-luogo" />
            <p class="errore" id="errore-luogo" data-errore="luogo"></p>
          </div>

          <div class="campi-due">
            <div class="campo">
              <label for="f-nome">Il tuo nome</label>
              <input id="f-nome" name="nome" type="text" autocomplete="name" required aria-describedby="errore-nome" />
              <p class="errore" id="errore-nome" data-errore="nome"></p>
            </div>
            <div class="campo">
              <label for="f-contatto">Email o telefono</label>
              <input id="f-contatto" name="contatto" type="text" autocomplete="email" required aria-describedby="errore-contatto" />
              <p class="errore" id="errore-contatto" data-errore="contatto"></p>
            </div>
          </div>

          <div class="campo">
            <label for="f-messaggio">Raccontaci la festa <span class="facoltativo">(facoltativo)</span></label>
            <textarea id="f-messaggio" name="messaggio" rows="4" maxlength="2000" aria-describedby="errore-messaggio"></textarea>
            <p class="errore" id="errore-messaggio" data-errore="messaggio"></p>
          </div>

          <label class="spunta">
            <input type="checkbox" name="dj" value="si" />
            <span>Aggiungi il DJ set dello zio dopo il concerto</span>
          </label>

          <div class="miele" aria-hidden="true">
            <label for="f-sito">Non compilare questo campo</label>
            <input id="f-sito" name="sito_web" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button class="bottone invia" type="submit">
            <span data-etichetta>Manda la richiesta</span>
            <Freccia />
          </button>
          <p class="stato" role="status" aria-live="polite" data-stato></p>
          <p class="privacy">Usiamo i tuoi dati solo per risponderti su questa festa.</p>
        </form>
      </div>
    </section>

    <dialog class="ingrandita" id="zoom-santino" aria-label="Il santino di Chambers">
      <form method="dialog"><button class="chiudi" aria-label="Chiudi">Chiudi</button></form>
      <Picture src={santino} formats={['avif', 'webp']} widths={[600, 1200]} sizes="min(90vw, 600px)" alt="Il santino di Chambers vestito da papa: San Marco da Negrisia" loading="lazy" />
    </dialog>
  </main>

  <Piede />
</Base>

<script>
  import { PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';
  import { validaRichiesta } from '../lib/richiesta';


const brani = [...document.querySelectorAll<HTMLButtonElement>('.brano')];
  const modulo = document.querySelector<HTMLFormElement>('[data-modulo]')!;
  const radio = (tipo: string) => modulo.querySelector<HTMLInputElement>(`input[name="tipo"][value="${tipo}"]`);

  // Signature interaction: picking a "track" lights it up and fills in the form below.
  function scegli(tipo: string | null) {
    for (const b of brani) b.setAttribute('aria-pressed', String(b.dataset.tipo === tipo));
    if (tipo) {
      const r = radio(tipo);
      if (r) r.checked = true;
    }
  }
  for (const b of brani) {
    b.addEventListener('click', () => scegli(b.getAttribute('aria-pressed') === 'true' ? null : b.dataset.tipo!));
  }
  modulo.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'tipo') scegli(t.value);
  });

  // Upcoming dates, read in the browser from the public view so the home stays static.
  async function caricaDate() {
    if (!PUBLIC_SUPABASE_URL || !PUBLIC_SUPABASE_ANON_KEY) return;
    const oggi = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Rome' });
    const url = `${PUBLIC_SUPABASE_URL}/rest/v1/concerti_pubblici?select=id,data,ora,citta,locale,privato&data=gte.${oggi}&order=data.asc,ora.asc&limit=4`;
    try {
      const res = await fetch(url, { headers: { apikey: PUBLIC_SUPABASE_ANON_KEY } });
      if (!res.ok) return;
      const date: { id: string; data: string; ora: string | null; citta: string; locale: string | null; privato: boolean }[] = await res.json();
      if (!date.length) return;
      const lista = document.querySelector<HTMLOListElement>('[data-prossime]')!;
      for (const c of date) {
        const li = document.createElement('li');
        const quando = new Date(`${c.data}T12:00:00`).toLocaleDateString('it-IT', { weekday: 'short', day: 'numeric', month: 'short' });
        const ora = c.ora ? ` · ${c.ora.slice(0, 5).replace(':', '.')}` : '';
        const dove = c.privato ? `Festa privata, ${c.citta}` : c.locale ? `${c.locale}, ${c.citta}` : c.citta;
        const q = Object.assign(document.createElement('span'), { className: 'date-quando', textContent: quando + ora });
        const d = Object.assign(document.createElement('span'), { className: 'date-dove', textContent: dove });
        const cal = Object.assign(document.createElement('a'), { className: 'date-cal', href: `/date/${c.id}.ics`, textContent: 'Aggiungi al calendario' });
        li.append(q, d, cal);
        lista.append(li);
      }
      lista.hidden = false;
      document.querySelector('[data-date-vuoto]')?.remove();
    } catch {
      // Network hiccup: the "dates coming soon" line stays.
    }
  }
  caricaDate();

  // Enlarge: small boxed pictures open full size in a native <dialog>.
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-zoom]')) {
    const d = document.getElementById(b.dataset.zoom!) as HTMLDialogElement | null;
    if (!d) continue;
    b.addEventListener('click', () => d.showModal());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  }

  // Booking form: validate in place, send with fetch, show errors under each field.
  const stato = modulo.querySelector<HTMLElement>('[data-stato]')!;
  const etichetta = modulo.querySelector<HTMLElement>('[data-etichetta]')!;
  const invia = modulo.querySelector<HTMLButtonElement>('button[type="submit"]')!;

  function mostraErrori(errori: Record<string, string>) {
    for (const p of modulo.querySelectorAll<HTMLElement>('[data-errore]')) {
      const nome = p.dataset.errore!;
      p.textContent = errori[nome] ?? '';
      modulo.querySelectorAll<HTMLInputElement>(`[name="${nome}"]`).forEach((el) => {
        if (errori[nome]) el.setAttribute('aria-invalid', 'true');
        else el.removeAttribute('aria-invalid');
      });
    }
    const primo = Object.keys(errori)[0];
    if (primo) modulo.querySelector<HTMLInputElement>(`[name="${primo}"]`)?.focus();
  }

  function messaggio(testo: string, link?: { href: string; testo: string }) {
    stato.replaceChildren(testo);
    if (link) stato.append(' ', Object.assign(document.createElement('a'), { href: link.href, textContent: link.testo }), '.');
  }

  modulo.addEventListener('submit', async (e) => {
    e.preventDefault();
    const dati = new FormData(modulo);
    const campi = Object.fromEntries([...dati.entries()].map(([k, v]) => [k, String(v)]));
    const v = validaRichiesta(campi);
    if (!v.ok) {
      mostraErrori(v.errori);
      messaggio('Manca qualcosa: lo trovi segnato in rosso.');
      return;
    }
    mostraErrori({});
    invia.disabled = true;
    etichetta.textContent = 'Sto mandando…';
    messaggio('');
    try {
      const res = await fetch(modulo.action, { method: 'POST', body: dati, headers: { Accept: 'application/json' } });
      const body = await res.json().catch(() => ({}));
      if (res.ok) {
        modulo.classList.add('inviato');
        modulo.replaceChildren(Object.assign(document.createElement('p'), {
          className: 'grazie',
          textContent: 'Ricevuto! Ti rispondiamo appena possibile. Intanto, scaldate le voci.',
        }));
        return;
      }
      if (body.errore === 'campi') {
        mostraErrori(body.campi ?? {});
        messaggio('Manca qualcosa: lo trovi segnato in rosso.');
      } else if (body.errore === 'non-attivo') {
        messaggio('Il modulo non è ancora attivo. Per ora scrivici su', { href: 'https://www.instagram.com/marisuglialberi/', testo: 'Instagram' });
      } else if (body.errore === 'troppe') {
