# Copia questo file in .env per lavorare in locale (il .env punta al progetto Supabase DEV).
# Su Vercel le stesse variabili vanno in Settings > Environment Variables, con le chiavi di PROD.
# Vedi SETUP.md per dove trovare ogni valore.

# Indirizzo pubblico del sito (in locale: http://localhost:4321)
SITE_URL=http://localhost:4321

# Supabase > Project Settings > API
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend > API Keys (per le email delle richieste di ingaggio)
RESEND_API_KEY=
# Finché il dominio non è verificato su Resend, onboarding@resend.dev consegna solo
# all'email del proprietario dell'account Resend (la Gmail del progetto).
EMAIL_FROM=Mari sugli alberi <onboarding@resend.dev>
# Dove arrivano le richieste di ingaggio: la Gmail del progetto
EMAIL_NOTIFICHE=

# Una stringa casuale qualsiasi: serve a non salvare gli indirizzi IP in chiaro
RATE_LIMIT_SALT=
